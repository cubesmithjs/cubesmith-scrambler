{
  "name": "@cubesmith/scrambler",
  "version": "0.15.0",
  "private": false,
  "type": "module",
  "sideEffects": true,
  "description": "Dependency-free WCA scramble generation. Pure computation only — no Web Workers, no DOM, no browser-only APIs — so it runs identically in Node, Bun, Vite, and both Next.js server and client contexts.",
  "license": "MIT",
  "author": "DrSiroukane",
  "homepage": "https://github.com/cubesmithjs/cubesmith-scrambler#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cubesmithjs/cubesmith-scrambler.git"
  },
  "bugs": {
    "url": "https://github.com/cubesmithjs/cubesmith-scrambler/issues"
  },
  "keywords": [
    "rubiks-cube",
    "cube",
    "scramble",
    "speedcubing",
    "wca",
    "typescript"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./draw": {
      "types": "./dist/draw/index.d.ts",
      "import": "./dist/draw/index.js"
    },
    "./unofficial": {
      "types": "./dist/unofficial/index.d.ts",
      "import": "./dist/unofficial/index.js"
    },
    "./unofficial/draw": {
      "types": "./dist/unofficial/draw/index.d.ts",
      "import": "./dist/unofficial/draw/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "bench": "vitest bench --run",
    "ci": "npm run typecheck && npm run test:coverage && npm run build"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.5",
    "tsup": "^8.5.0",
    "typescript": "^5",
    "vitest": "^4.1.12"
  }
}
